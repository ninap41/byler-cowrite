run = "npm start"
entrypoint = "server.js"
modules = ["nodejs-20", "web", "postgresql-16"]

[nix]
channel = "stable-25_05"

[deployment]
build = ["npm", "run", "build"]
run = ["npm", "start"]
deploymentTarget = "vm"

[[ports]]
localPort = 3000
externalPort = 80

[[ports]]
localPort = 4772
externalPort = 8081

[[ports]]
localPort = 5909
externalPort = 8099

[[ports]]
localPort = 6525
externalPort = 8000

[[ports]]
localPort = 6556
externalPort = 4200

[[ports]]
localPort = 7928
externalPort = 5000

[[ports]]
localPort = 8553
externalPort = 3001

[[ports]]
localPort = 14566
externalPort = 6000

[[ports]]
localPort = 14603
externalPort = 8080

[[ports]]
localPort = 15010
externalPort = 3002

[[ports]]
localPort = 15316
externalPort = 8008

[[ports]]
localPort = 15750
externalPort = 5173

[[ports]]
localPort = 16476
externalPort = 3000

[[ports]]
localPort = 18990
externalPort = 3003

[[ports]]
localPort = 20351
externalPort = 6800

[[ports]]
localPort = 22638
externalPort = 9000

[workflows]
runButton = "Project"

[[workflows.workflow]]
name = "Project"
mode = "parallel"
author = "agent"

[[workflows.workflow.tasks]]
task = "workflow.run"
args = "Start application"

[[workflows.workflow]]
name = "Start application"
author = "agent"

[[workflows.workflow.tasks]]
task = "shell.exec"
args = "npm start"
waitForPort = 3000

[workflows.workflow.metadata]
outputType = "console"

[postMerge]
path = "scripts/post-merge.sh"
timeoutMs = 180000
