{
  "name": "byler-cowrite",
  "version": "3.0.1",
  "description": "A real-time, round-robin writing game and writing software for Stranger Things fanfiction",
  "type": "module",
  "main": "server.js",
  "scripts": {
    "start": "node server.js",
    "prestart": "npm run build",
    "build": "node scripts/build.mjs",
    "typecheck": "tsc --noEmit && tsc -p tsconfig.server.json",
    "pretest": "npm run build",
    "test": "node --test \"test/**/*.test.mjs\"",
    "reseed-content": "node scripts/reseed-content.mjs",
    "reseed-achievements": "node scripts/reseed-content.mjs content achievements",
    "discord-register": "node scripts/discord-register.mjs"
  },
  "dependencies": {
    "express": "^4.21.2",
    "nodemailer": "^9.0.3",
    "pg": "^8.22.0",
    "esbuild": "^0.28.2",
    "socket.io": "^4.8.1"
  },
  "devDependencies": {
    "jsdom": "^29.1.1",
    "socket.io-client": "^4.8.3",
    "typescript": "^7.0.2"
  }
}
