{
 "_comment": "Which font each theme uses, per role. Generated from the --font-* custom properties in public/css/base.css; test/fonts.test.mjs fails if the two ever drift apart. Families come from the Google Fonts CDN link in every page's <head> \u2014 there are no font files in this repo.",
 "source": {
  "css": "public/css/base.css",
  "themeList": "public/js/theme.js",
