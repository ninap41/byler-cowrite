 },
 "roles": {
  "display": "headings, the hero title, big UI type (--font-display)",
  "body": "general UI text (--font-body)",
  "story": "story lines and the solo-write editor surface (--font-story)",
  "mono": "codes, timers, hints, the HTML source view (--font-mono)"
 },
 "families": {
  "Fraunces": {
   "stack": "\"Fraunces\", serif",
